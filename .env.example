# ---- LLM provider -------------------------------------------------------
# mock | groq | nvidia_nim | xai_grok | openai_compat | anthropic | ollama
DFG_LLM_PROVIDER=mock
GROQ_API_KEY=
DFG_GROQ_MODEL=qwen/qwen3.8-27b
DFG_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
DFG_GROQ_REASONING_EFFORT=medium
NVIDIA_API_KEY=
DFG_NIM_MODEL=moonshotai/kimi-k3
DFG_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# low | medium | high (reasoning models); empty to omit
DFG_NIM_REASONING_EFFORT=low
# total seconds allowed per LLM call before falling back to the rule-based parser
DFG_LLM_TIMEOUT=90
XAI_API_KEY=
DFG_GROK_MODEL=grok-4
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
ANTHROPIC_API_KEY=
DFG_ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ---- Data sources -------------------------------------------------------
# Optional: enables live US Census ACS fetch (otherwise bundled snapshot used)
CENSUS_API_KEY=

# ---- Runtime ------------------------------------------------------------
DFG_WORKSPACE=./workspace
DFG_CONFIG=./config/config.yaml
DFG_LOG_LEVEL=INFO
DFG_LOG_JSON=false
DFG_CORS_ORIGINS=http://localhost:3000
# Embedding backend for semantic similarity: tfidf | sentence_transformers
DFG_EMBEDDING_BACKEND=tfidf
